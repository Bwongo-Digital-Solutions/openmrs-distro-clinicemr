# Copy values into your deployment secret store / .env; never commit real secrets.
AMANAH_AI_ENABLED=false
AMANAH_OLLAMA_IMAGE=ollama/ollama:latest
AMANAH_OLLAMA_MODEL=

# Keycloak development identity provider. Keep admin and DB passwords secret.
AMANAH_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2
AMANAH_KEYCLOAK_HOSTNAME=http://localhost:8081
AMANAH_KEYCLOAK_ADMIN_USERNAME=admin
AMANAH_KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
AMANAH_KEYCLOAK_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_RANDOM_SECRET

# Issuer is localhost because access is through an SSH tunnel.
AMANAH_OIDC_ISSUER=http://localhost:8081/realms/amanah-gen
AMANAH_OIDC_AUDIENCE=amanah-gen-api
# Internal Compose URL avoids public-IP hairpin routing.
AMANAH_JWT_JWKS_URL=http://amanah-keycloak:8080/realms/amanah-gen/protocol/openid-connect/certs
AMANAH_ALLOWED_ROLE=AMANAH_GEN_AI_USER
AMANAH_MAX_INPUT_CHARS=4000
